# LINE Bot
LINE_CHANNEL_ACCESS_TOKEN=your_line_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Google Sheets
SHEET_NAME=Antigravity_Stock_Bot
WORKSHEET_NAME=RawData
# Option A: paste the full JSON content of credentials.json as a single line
GOOGLE_CREDENTIALS_JSON=
# Option B: path to the credentials.json file (local dev)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Frontend URL for CORS (set to your Railway frontend URL after deploy)
FRONTEND_URL=https://your-frontend.railway.app
